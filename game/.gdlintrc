# gdlint configuration.
#
# Only deviations from gdtoolkit's defaults are recorded. Each one is a
# decision, not a preference.

# 100 columns, which is the width gdformat normalises to. The rest of the
# repository wraps at 120, but GDScript follows its formatter: a linter that
# allowed 120 would accept lines the formatter then rewrites, so the check and
# the formatter would disagree on every long signature.
max-line-length: 100

# Autoload singletons are referenced by the name registered in project.godot,
# which is PascalCase by Godot convention. Without this, every call to
# RngService or HostBridge would be reported as a naming violation.
class-name: '([A-Z][a-z0-9]*)+'

# Functions prefixed with an underscore are private by Godot convention, and
# engine callbacks such as _ready and _unhandled_input are named by the engine.
function-name: '(_on_)?[a-z_][a-z0-9_]*'

# Signal callbacks and engine overrides legitimately take arguments they do not
# use; an underscore prefix already marks them as intentional.
function-arguments-number: 6
