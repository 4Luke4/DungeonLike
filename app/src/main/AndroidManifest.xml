<?xml version="1.0" encoding="utf-8"?>
<!--
    DungeonLike application manifest.

    No permissions are declared. The game is offline and single-player, and a
    permission may only be added together with the reasoning in
    docs/architecture/THREAT_MODEL.md. In particular INTERNET belongs to the
    Play Games integration alone, never to the base application.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The product ships for 64-bit ARM phones and tablets. Declaring the
        touchscreen as not required keeps the application installable on
        keyboard-and-mouse devices such as desktop-mode tablets, which the
        input handling explicitly supports.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".DungeonLikeApplication"
        android:allowBackup="false"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.DungeonLike.Splash">

        <!--
            The engine is hosted by a single activity.

            android:screenOrientation and android:configChanges are load-bearing:
            the Godot Android library does not support automatic resize or
            orientation configuration events for an embedded instance and can
            crash on them, so the activity fixes the orientation and handles
            those configuration changes itself instead of being recreated.
            The orientation declared here must match the Godot project's
            display/window/handheld/orientation setting.

            android:excludeFromRecents is deliberately absent: a game the player
            switches away from should come back exactly where they left it.
        -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.DungeonLike.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
