<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules.

    Nothing is backed up or transferred. Save data is authenticated with a key
    that never leaves this device's keystore, so a restored save would fail its
    integrity check and be reported as tampered. Excluding the data keeps that
    from happening to an honest player; see docs/architecture/THREAT_MODEL.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
