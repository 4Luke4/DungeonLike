# EditorConfig -- https://editorconfig.org
#
# Keeps whitespace consistent across editors so that a contributor's editor
# settings never show up as unrelated noise in a diff.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown gives meaning to two trailing spaces (a hard line break), so trailing
# whitespace must not be stripped automatically here.
trim_trailing_whitespace = false

[*.{kt,kts,gradle}]
indent_size = 4

# GDScript indents with TABS. This is not a preference: it is the official
# GDScript style guide's rule and the editor default, and `gdformat --check`
# enforces it in CI, so spaces here would fail the build.
[*.gd]
indent_style = tab

# Godot scene, resource and project files are written by the editor with tabs.
[*.{tscn,tres,godot,gdshader,gdshaderinc}]
indent_style = tab

[*.cs]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{properties,versions}]
indent_size = 4

[Makefile]
indent_style = tab

# Generated by Gradle; never hand-edited, so it is left exactly as produced.
[gradle/wrapper/gradle-wrapper.properties]
trim_trailing_whitespace = false
