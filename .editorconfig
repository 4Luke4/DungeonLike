# EditorConfig — https://editorconfig.org
# Indentation rules follow each ecosystem's own official style guide rather than
# a single repository-wide preference, so that generated files and formatter
# output (ktlint, gdformat, super-linter) never fight the editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Kotlin official code style: 4 spaces, 120 columns.
[*.{kt,kts}]
indent_style = space
indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.java]
indent_style = space
indent_size = 4

# GDScript is tab-indented by the official Godot style guide, and gdformat
# enforces tabs. Spaces here would make every Godot file fail formatting.
#
# The line limit is gdformat's canonical width rather than the repository's 120,
# for the same reason: the formatter rewrites anything longer, so declaring a
# wider limit here would only mislead the author.
[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100

# Godot-authored files (scenes, resources, project settings, import metadata)
# are written by the editor with tabs; reformatting them creates noise diffs.
[*.{tscn,tres,godot,import,gdshader}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,toml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown uses two trailing spaces as a hard line break, so trailing
# whitespace must survive.
trim_trailing_whitespace = false
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{properties,versions}]
indent_size = 4

[Makefile]
indent_style = tab

# Generated by Gradle; left exactly as produced.
[gradle/wrapper/**]
insert_final_newline = false
trim_trailing_whitespace = false
