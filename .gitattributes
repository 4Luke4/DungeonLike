# Normalize every text file to LF in the repository. Working-tree endings are
# left to each contributor's platform, but what gets committed is always LF so
# that Gradle, Godot and the CI linters see identical bytes everywhere.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe refuses to run them.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# The Gradle start script is executed by /bin/sh and must stay LF even on
# Windows checkouts.
gradlew         text eol=lf

# Source and configuration files: force text handling so that a stray CRLF in a
# contributor's editor never lands in the repository.
*.kt            text diff=kotlin
*.kts           text diff=kotlin
*.java          text diff=java
*.gd            text
*.gdshader      text
*.tscn          text
*.tres          text
*.godot         text
*.import        text
*.cfg           text
*.properties    text
*.pro           text
*.md            text diff=markdown
*.xml           text
*.yml           text
*.yaml          text
*.toml          text
*.json          text
*.csv           text
*.sh            text eol=lf
*.py            text diff=python

# Binary assets: never diffed, never end-of-line converted.
*.aar           binary
*.jar           binary
*.pck           binary
*.zip           binary
*.tpz           binary
*.so            binary
*.png           binary
*.jpg           binary
*.webp          binary
*.ico           binary
*.ttf           binary
*.otf           binary
*.ogg           binary
*.wav           binary
*.mp3           binary
*.pdf           binary
*.jks           binary
*.keystore      binary

# The Gradle wrapper is generated by Gradle itself; keep it out of language
# statistics and out of review diffs.
gradle/wrapper/gradle-wrapper.jar   binary linguist-generated=true
gradlew                             linguist-generated=true
gradlew.bat                         linguist-generated=true

# Repository infrastructure that is meaningless inside a source archive.
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.gitmessage     export-ignore
docs/           export-ignore
tools/          export-ignore
