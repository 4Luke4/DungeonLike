# Normalise line endings in the repository to LF on commit, regardless of the
# contributor's platform. Without this, a Windows checkout can introduce CRLF
# into shell scripts and Gradle wrappers and make them non-executable at runtime.
* text=auto eol=lf

# --- Explicitly text ---------------------------------------------------------
*.md        text
*.txt       text
*.yml       text
*.yaml      text
*.json      text
*.toml      text
*.properties text
*.xml       text
*.py        text
*.kt        text
*.kts       text
*.cs        text
*.gradle    text
*.pro       text
*.cfg       text
*.sh        text eol=lf
gradlew     text eol=lf

# Godot text formats. Scenes and resources are deliberately kept in Godot's
# text-based variants so that a content change is reviewable line by line.
*.gd        text
*.gdshader  text
*.gdshaderinc text
*.tscn      text
*.tres      text
*.godot     text

# Windows-only entry points must keep CRLF or cmd.exe mis-parses them.
*.bat       text eol=crlf
gradlew.bat text eol=crlf

# --- Explicitly binary -------------------------------------------------------
# Marking these prevents any end-of-line or diff mangling of binary payloads.
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.ogg       binary
*.wav       binary
*.mp3       binary
*.zip       binary
*.aar       binary
*.jar       binary
*.apk       binary
*.aab       binary
*.so        binary
*.dll       binary
*.keystore  binary
*.jks       binary
*.import    binary
*.res       binary
*.pck       binary

# Godot binary resources. Godot also emits text-based .tres/.tscn, which are
# intentionally left as normal text so they stay reviewable in diffs.
*.scn       binary
*.material  binary

# --- Generated / vendored ----------------------------------------------------
# Keep generated and vendored paths out of language statistics and collapsed in
# pull request diffs, so review attention stays on hand-written code.
gradle/wrapper/gradle-wrapper.jar binary linguist-vendored
*.lock                            linguist-generated=true -diff

# --- Archive hygiene ---------------------------------------------------------
# Excluded from `git archive` exports: development-only material that should not
# appear in a source distribution.
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.gitmessage     export-ignore
.vscode/        export-ignore
docs/           export-ignore
scripts/        export-ignore
